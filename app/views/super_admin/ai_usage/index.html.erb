<div class="p-6 space-y-6">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div><h1 class="text-2xl font-semibold"><%= t('super_admin.ai_usage.title') %></h1><p class="text-sm text-slate-600"><%= t('super_admin.ai_usage.subtitle') %></p></div>
    <%= form_with url: super_admin_ai_usage_path, method: :get, class: 'flex flex-wrap gap-3 items-end' do %>
      <label class="text-sm"><%= t('super_admin.ai_usage.month') %> <%= month_field_tag :month, @month.strftime('%Y-%m'), class: 'block rounded border p-2' %></label>
      <label class="text-sm"><%= t('super_admin.ai_usage.account') %> <%= select_tag :account_id, options_from_collection_for_select(@accounts, :id, :name, @account&.id), include_blank: t('super_admin.ai_usage.all_accounts'), class: 'block rounded border p-2' %></label>
      <%= submit_tag t('super_admin.ai_usage.filter'), class: 'rounded bg-blue-600 px-4 py-2 text-white' %>
      <%= link_to t('super_admin.ai_usage.export_csv'), super_admin_ai_usage_export_path(month: @month.strftime('%Y-%m'), account_id: @account&.id), class: 'rounded border px-4 py-2' %>
    <% end %>
  </div>

  <% if @alerts.any? %><section class="rounded border border-amber-300 bg-amber-50 p-4"><h2 class="font-semibold"><%= t('super_admin.ai_usage.alerts') %></h2><ul class="list-disc pl-5"><% @alerts.each do |alert| %><li><%= alert %></li><% end %></ul></section><% end %>

  <section class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
    <% [[t('super_admin.ai_usage.total_cost'), number_to_currency(@summary[:cost], unit: 'USD ', precision: 8)], [t('super_admin.ai_usage.real_calls'), @summary[:calls]], [t('super_admin.ai_usage.charged_messages'), @summary[:messages]], [t('super_admin.ai_usage.calls_per_message'), "#{@summary[:avg_calls].round(2)} / #{@summary[:p95_calls]}"], [t('super_admin.ai_usage.input_tokens'), number_with_delimiter(@summary[:input_tokens])], [t('super_admin.ai_usage.output_tokens'), number_with_delimiter(@summary[:output_tokens])], [t('super_admin.ai_usage.average_cost_message'), number_to_currency(@summary[:messages].positive? ? @summary[:cost] / @summary[:messages] : 0, unit: 'USD ', precision: 8)], [t('super_admin.ai_usage.cost_plan'), @summary[:plan_cost_percent] ? "#{@summary[:plan_cost_percent]}%" : '—']].each do |label, value| %>
      <article class="rounded border bg-white p-4"><p class="text-sm text-slate-600"><%= label %></p><p class="mt-1 text-xl font-semibold"><%= value %></p></article>
    <% end %>
  </section>

  <section class="grid gap-6 xl:grid-cols-2">
    <%= render 'chart', title: t('super_admin.ai_usage.daily_cost'), rows: @daily_cost.sort.map { |key, value| [key.strftime('%d'), value.to_f] } %>
    <%= render 'chart', title: t('super_admin.ai_usage.model_cost'), rows: @model_cost.sort_by { |_key, value| -value }.map { |key, value| [key, value.to_f] } %>
    <%= render 'stacked_calls', daily_calls: @daily_calls %>
    <%= render 'chart', title: t('super_admin.ai_usage.message_distribution'), rows: @calls_per_message.map { |calls, count| [t('super_admin.ai_usage.call_count', count: calls), count] } %>
  </section>

  <section class="rounded border bg-white p-4"><h2 class="mb-3 text-lg font-semibold"><%= t('super_admin.ai_usage.account_ranking') %></h2><div class="overflow-x-auto"><table class="w-full text-left text-sm"><thead><tr><th class="p-2"><%= t('super_admin.ai_usage.account') %></th><th class="p-2"><%= t('super_admin.ai_usage.cost') %></th><th class="p-2"><%= t('super_admin.ai_usage.plan_price') %></th><th class="p-2"><%= t('super_admin.ai_usage.cost_plan_ratio') %></th></tr></thead><tbody><% @company_ranking.each do |account, cost| %><tr class="border-t"><td class="p-2"><%= account.name %></td><td class="p-2"><%= number_to_currency(cost, unit: 'USD ', precision: 8) %></td><td class="p-2"><%= number_to_currency(account.plan&.price_monthly.to_f, unit: 'USD ') %></td><td class="p-2"><%= account.plan&.price_monthly.to_f.positive? ? "#{(cost / account.plan.price_monthly * 100).round(1)}%" : '—' %></td></tr><% end %></tbody></table></div></section>

  <section class="rounded border bg-white p-4"><h2 class="mb-3 text-lg font-semibold"><%= t('super_admin.ai_usage.account_bucket') %></h2><div class="overflow-x-auto"><table class="w-full text-left text-sm"><thead><tr><th class="p-2"><%= t('super_admin.ai_usage.account') %></th><th class="p-2"><%= t('super_admin.ai_usage.bucket') %></th><th class="p-2"><%= t('super_admin.ai_usage.consumed_limit') %></th><th class="p-2"><%= t('super_admin.ai_usage.percent') %></th><th class="p-2"><%= t('super_admin.ai_usage.messages') %></th><th class="p-2"><%= t('super_admin.ai_usage.calls') %></th><th class="p-2"><%= t('super_admin.ai_usage.tokens') %></th><th class="p-2"><%= t('super_admin.ai_usage.cost') %></th></tr></thead><tbody><% @bag_rows.each do |row| %><tr class="border-t"><td class="p-2"><%= row[:account]&.name %></td><td class="p-2"><%= row[:bucket] %></td><td class="p-2"><%= row[:consumed] || '—' %> / <%= row[:limit] || '—' %></td><td class="p-2"><%= row[:percent] ? "#{row[:percent]}%" : '—' %></td><td class="p-2"><%= row[:messages] %></td><td class="p-2"><%= row[:calls] %></td><td class="p-2"><%= number_with_delimiter(row[:tokens]) %></td><td class="p-2"><%= number_to_currency(row[:cost], unit: 'USD ', precision: 8) %></td></tr><% end %></tbody></table></div></section>

  <section class="rounded border bg-white p-4"><h2 class="mb-3 text-lg font-semibold"><%= t('super_admin.ai_usage.call_details') %></h2><div class="max-h-80 overflow-auto"><table class="w-full text-left text-sm"><thead><tr><th class="p-2"><%= t('super_admin.ai_usage.date') %></th><th class="p-2"><%= t('super_admin.ai_usage.account') %></th><th class="p-2"><%= t('super_admin.ai_usage.bucket') %></th><th class="p-2"><%= t('super_admin.ai_usage.feature') %></th><th class="p-2"><%= t('super_admin.ai_usage.model') %></th><th class="p-2"><%= t('super_admin.ai_usage.tokens') %></th><th class="p-2"><%= t('super_admin.ai_usage.cost') %></th></tr></thead><tbody><% @events.group_by(&:usage_group_id).each do |group_id, rows| %><tr class="border-t"><td class="p-2"><%= rows.first.created_at %></td><td class="p-2"><%= rows.first.account.name %></td><td class="p-2"><%= rows.first.bucket %></td><td class="p-2"><%= rows.first.feature %></td><td class="p-2"><%= rows.map(&:model).uniq.join(', ') %></td><td class="p-2"><%= number_with_delimiter(rows.sum(&:input_tokens) + rows.sum(&:output_tokens)) %></td><td class="p-2"><%= link_to number_to_currency(rows.sum(&:cost_usd), unit: 'USD ', precision: 8), super_admin_ai_usage_message_path(group_id) %></td></tr><% end %></tbody></table><% if @events.empty? %><p class="p-3 text-sm text-slate-500"><%= t('super_admin.ai_usage.no_data') %></p><% end %></div></section>
</div>
