<div class="p-6"><%= link_to t('super_admin.ai_usage.back'), super_admin_ai_usage_path %><h1 class="my-4 text-2xl font-semibold"><%= t('super_admin.ai_usage.message_title') %></h1><div class="overflow-x-auto rounded border bg-white"><table class="w-full text-left text-sm"><thead><tr><th class="p-3"><%= t('super_admin.ai_usage.date') %></th><th class="p-3"><%= t('super_admin.ai_usage.model') %></th><th class="p-3"><%= t('super_admin.ai_usage.input_tokens') %></th><th class="p-3"><%= t('super_admin.ai_usage.output_tokens') %></th><th class="p-3"><%= t('super_admin.ai_usage.latency') %></th><th class="p-3"><%= t('super_admin.ai_usage.status_error') %></th><th class="p-3"><%= t('super_admin.ai_usage.cost') %></th></tr></thead><tbody><% @events.each do |event| %><tr class="border-t"><td class="p-3"><%= event.created_at %></td><td class="p-3"><%= event.model %></td><td class="p-3"><%= event.input_tokens %></td><td class="p-3"><%= event.output_tokens %></td><td class="p-3"><%= event.latency_ms %> ms</td><td class="p-3"><%= [event.status, event.error_class].compact.join(' · ') %></td><td class="p-3"><%= number_to_currency(event.cost_usd, unit: 'USD ', precision: 8) %></td></tr><% end %></tbody></table></div></div>
