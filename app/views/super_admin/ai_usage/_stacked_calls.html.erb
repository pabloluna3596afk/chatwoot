<section class="rounded border bg-white p-4"><h2 class="mb-3 text-lg font-semibold"><%= t('super_admin.ai_usage.daily_calls') %></h2><% days = daily_calls.group_by { |(day, _bucket), _count| day }; maximum = days.values.map { |entries| entries.sum { |_key, count| count } }.max.to_f %><div class="space-y-2"><% days.sort.each do |day, entries| %><% offset = 0.0 %><div class="grid grid-cols-[3rem_1fr_auto] items-center gap-3 text-sm"><span><%= day.strftime('%d') %></span><svg class="h-4 w-full rounded bg-slate-100" viewBox="0 0 100 12" preserveAspectRatio="none" role="img" aria-label="<%= day %>: <%= entries.sum { |_key, count| count } %> calls"><% entries.sort_by { |((_, bucket), _)| bucket }.each do |((_, bucket), count)| %><% width = maximum.positive? ? count.to_f / maximum * 100 : 0 %><rect x="<%= offset %>" y="0" width="<%= width %>" height="12" fill="<%= { 'captain_responses' => '#2563eb', 'copilot' => '#7c3aed', 'internal' => '#0f766e' }.fetch(bucket, '#64748b') %>" /><% offset += width %><% end %></svg><span><%= entries.sum { |_key, count| count } %></span></div><% end %><% if days.empty? %><p class="text-sm text-slate-500"><%= t('super_admin.ai_usage.no_data') %></p><% end %><div class="flex flex-wrap gap-4 pt-2 text-xs"><% [['captain_responses', '#2563eb'], ['copilot', '#7c3aed'], ['internal', '#0f766e']].each do |bucket, color| %><span class="flex items-center gap-1"><svg class="size-3" aria-hidden="true"><rect width="12" height="12" fill="<%= color %>" /></svg><%= bucket %></span><% end %></div></div></section>
