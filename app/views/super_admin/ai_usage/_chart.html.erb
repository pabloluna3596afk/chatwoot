<section class="rounded border bg-white p-4"><h2 class="mb-3 text-lg font-semibold"><%= title %></h2><% max_value = rows.map(&:last).max.to_f %><div class="space-y-2"><% rows.each do |label, value| %><div class="grid grid-cols-[minmax(7rem,12rem)_1fr_auto] items-center gap-3 text-sm"><span class="truncate"><%= label %></span><div class="h-3 rounded bg-slate-100"><svg class="h-3 w-full" role="img" aria-label="<%= label %>: <%= value %>"><rect height="12" width="<%= max_value.positive? ? (value.to_f / max_value * 100).round : 0 %>%" fill="#2563eb" /></svg></div><span><%= value.round(4) %></span></div><% end %><% if rows.empty? %><p class="text-sm text-slate-500"><%= t('super_admin.ai_usage.no_data') %></p><% end %></div></section>
