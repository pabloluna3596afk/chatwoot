<section class="mt-8 rounded-lg border border-n-weak p-6">
  <h2 class="mb-3 text-lg font-semibold"><%= t('super_admin.account_features.title') %></h2>
  <% if account.plan %>
    <div class="mb-4">
      <p><%= t('super_admin.account_features.plan') %>: <strong><%= account.plan.name %></strong></p>
      <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
        <% Plan::LIMITS.each do |limit| %>
          <li><%= limit["label_#{I18n.locale}".to_sym] || limit[:label_en] %>: <%= account.plan.limit(limit[:key]) || '∞' %></li>
        <% end %>
        <li><%= t('super_admin.plans.copilot_allowance') %>: <%= account.plan.copilot_available? ? '✓' : '—' %></li>
      </ul>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full text-left text-sm">
        <thead><tr><th class="p-2"><%= t('super_admin.account_features.feature') %></th><th class="p-2"><%= t('super_admin.account_features.status') %></th><th class="p-2"><%= t('super_admin.account_features.source') %></th><th class="p-2"><%= t('super_admin.account_features.action') %></th></tr></thead>
        <tbody>
          <% Plan::ACCOUNT_FEATURES.each do |feature| %>
            <% override = account.feature_override_for(feature[:key]) %>
            <% active = feature[:flags].any? { |flag| account.feature_enabled?(flag) } %>
            <% origins = feature[:flags].map { |flag| account.feature_source(flag) }.uniq %>
            <tr class="border-t border-n-weak">
              <td class="p-2"><%= feature[:base] ? t("super_admin.account_features.flags.#{feature[:key]}", default: feature[:label_en]) : (feature["label_#{I18n.locale}".to_sym] || feature[:label_en]) %></td>
              <td class="p-2"><%= t("super_admin.account_features.#{active ? 'active' : 'inactive'}") %></td>
              <td class="p-2"><%= override ? "#{t('super_admin.account_features.exception')}: #{override.reason}#{override.expires_at ? " · #{t('super_admin.account_features.expires_at')} #{l(override.expires_at, format: :short)}" : ''}" : origins.map { |origin| t("super_admin.account_features.#{origin}", default: origin.to_s) }.join(', ') %></td>
              <td class="p-2">
                <% if override %>
                  <%= button_to t('super_admin.account_features.return_to_plan'), feature_override_super_admin_account_path(account, feature_key: feature[:key]), method: :delete, class: 'button' %>
                <% else %>
                  <%= form_with url: feature_override_super_admin_account_path(account), method: :post, class: 'flex flex-wrap items-center gap-2' do |form| %>
                    <%= form.hidden_field :feature_key, value: feature[:key] %>
                    <%= form.hidden_field :enabled, value: (!active).to_s %>
                    <%= form.text_field :reason, required: true, placeholder: t('super_admin.account_features.reason'), class: 'form-control' %>
                    <%= form.date_field :expires_at, class: 'form-control', aria: { label: t('super_admin.account_features.expires_at') } %>
                    <%= form.submit(t("super_admin.account_features.#{active ? 'remove' : 'give'}"), class: 'button') %>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
          <tr class="border-t border-n-weak">
            <td class="p-2"><%= t('super_admin.plans.copilot_allowance') %></td>
            <td class="p-2"><%= account.plan.copilot_available? ? '✓' : '—' %></td>
            <td class="p-2"><%= t('super_admin.account_features.plan') %></td>
            <td class="p-2">—</td>
          </tr>
        </tbody>
      </table>
    </div>
  <% else %>
    <p><%= t('super_admin.account_features.no_plan') %></p>
  <% end %>
</section>
